---
import type { IconName } from '../site';
interface Props { name: IconName; size?: number }
const { name, size = 26 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'sueldo' && (
    <>
      <rect x="2.5" y="6" width="19" height="12" rx="2" />
      <circle cx="12" cy="12" r="2.6" />
      <path d="M6 9.5v5M18 9.5v5" />
    </>
  )}
  {name === 'prestaciones' && (
    <>
      <rect x="3" y="7.5" width="18" height="12" rx="2" />
      <path d="M9 7.5V5.5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5.5v2" />
      <path d="M3 12.5h18M10.5 12.5v1.5h3v-1.5" />
    </>
  )}
  {name === 'prestamo' && (
    <>
      <path d="M3 9.5 12 4l9 5.5" />
      <path d="M4.5 9.5v8M9 9.5v8M15 9.5v8M19.5 9.5v8" />
      <path d="M3 20h18" />
    </>
  )}
  {name === 'casa' && (
    <>
      <path d="M3.5 11 12 4l8.5 7" />
      <path d="M5.5 9.5V20h13V9.5" />
      <path d="M10 20v-5.5h4V20" />
    </>
  )}
</svg>
